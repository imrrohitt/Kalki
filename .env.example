# LLM (Ollama via LiteLLM / Google ADK)
LLM_MODEL=ollama/gemma:2b
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434

# Whisper
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_ENABLED=true
WHISPER_MIN_SILENCE_MS=500
WHISPER_BEAM_SIZE=5

# Captions / media
CAPTION_FONT_PATH=assets/fonts/Montserrat-Bold.ttf
MAX_VIDEO_DURATION_SEC=60
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
STORAGE_DIR=storage
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
