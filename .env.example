# LLM (DeepSeek via LiteLLM / Google ADK)
# Caption agent disables DeepSeek V4 thinking. Do not set reasoning_effort.
LLM_MODEL=openai/deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# Whisper
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_ENABLED=true
WHISPER_MIN_SILENCE_MS=500
WHISPER_BEAM_SIZE=5

# Captions / media
CAPTION_FONT_PATH=assets/fonts/Montserrat-Bold.ttf
# Max source video length in seconds. 0 = no limit.
MAX_VIDEO_DURATION_SEC=0
# LLM grouping window in seconds. 0 = one request for the whole video.
CAPTION_CHUNK_SECONDS=0
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
SPLIT_LAYOUT_ENABLED=true
# Default motion-graphics theme: paper | noir | tech | ivory.
# Per-upload override: POST /api/v1/videos?theme=noir
GRAPHICS_THEME=paper
CAPTION_HEURISTIC_ONLY=false
SFX_ENABLED=true
SFX_LLM_ENABLED=true
SFX_DIR=Sound Effects V4
TRANSCRIPT_REPAIR_LLM_ENABLED=true
SCENES_LLM_ENABLED=true
STORAGE_DIR=storage
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
